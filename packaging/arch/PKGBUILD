# PKGBUILD do localpdf para Arch (uso pessoal do João; não publicado no AUR).
# Instala a árvore FHS (bin/ + share/) do tarball da release — o mesmo artefato
# que o package.sh gera. O sha256 fica SKIP no repo (o hash só existe após a
# release); o job arch do CI substitui pelo real ao construir o pacote.
#
#   makepkg -si   (local, com o tarball da release ao lado)

pkgname=localpdf
pkgver=0.14.17
pkgrel=1
pkgdesc='Editor de PDF local e open-source, escrito em Rust puro'
arch=(x86_64)
url='https://github.com/Anon5T4R/local-pdf'
license=('MIT OR Apache-2.0')
depends=(glibc gcc-libs libxcb libxrandr libxi libxcursor libxkbcommon)
optdepends=('cups-client: impressão (lp/lpstat via craft-print)'
            'xdg-desktop-portal: seletor nativo de arquivos (GNOME/KDE já trazem)')
options=(!debug)
source=("localpdf-$pkgver-linux-x86_64.tar.gz")
sha256sums=('SKIP')

package() {
  cd "$srcdir"
  install -dm755 "$pkgdir/usr"
  cp -a "localpdf-$pkgver-linux-x86_64/bin" "$pkgdir/usr/"
  cp -a "localpdf-$pkgver-linux-x86_64/share" "$pkgdir/usr/"
}
